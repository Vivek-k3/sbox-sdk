{
  "extends": "@sbox-sdk/config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM", "DOM.AsyncIterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/live/**",
    "src/*/live.ts"
  ]
}
